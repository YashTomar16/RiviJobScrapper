# Copy to .env and fill in values.

# Groq LLM (Key Insights)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=4096

# Storage
DATABASE_URL=sqlite:///./data/rivi.db

# Paths (optional overrides; defaults resolve from project root)
# RIVI_DATA_DIR=./data
# RIVI_LOGS_DIR=./logs
# RIVI_COMPANIES_CSV=./data/companies.csv

# Weekly scheduler
WEEKLY_CRON=0 6 * * 1
WEEKLY_TIMEZONE=UTC

# Scrape
SCRAPE_CONCURRENCY=5
SCRAPE_TIMEOUT_SECONDS=30
SCRAPE_DOMAIN_DELAY_SECONDS=0.5
SCRAPE_RESPECT_ROBOTS=true
RESOLVE_CONCURRENCY=10
RESOLVE_TIMEOUT_SECONDS=8

# Alerts (Phase 4) — Slack and/or email
ALERTS_ENABLED=true
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true

# Basic auth for UI when exposed beyond localhost (leave empty to disable)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Logging
LOG_LEVEL=INFO
